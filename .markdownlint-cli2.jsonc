// Config de markdownlint para o repo IGNIÇÃO.
// Desabilita apenas regras incompatíveis com livro em prosa e estrutura multi-H1/callouts.
{
  "config": {
    // Linha pode ser longa em prosa: não é código.
    "MD013": false,

    // Headings repetidos como "### Quando usar" são padrão estrutural
    // dos capítulos e fases: intencional, não erro.
    "MD024": false,

    // Espaçamento "compacto" em tabelas é escolha estética, não erro.
    "MD060": false,

    // Texto em **negrito** sozinho às vezes funciona como mini-heading
    // dentro de seções; manter flexibilidade narrativa.
    "MD036": false,

    // Volumes têm múltiplos H1 (agrupadores temáticos de fases e capítulos):
    // intencional.
    "MD025": false,

    // MD041: primeiro heading não precisa ser h1 (README abre com <div align="center">).
    "MD041": false,

    // MD028: blank in blockquote: necessário para separar callouts
    // adjacentes ([!note] / [!tip]). Callouts partidos sem novo [!tipo]
    // são bloqueados pelo validate_v53.py.
    "MD028": false,

    // MD035: exige separador horizontal padronizado "---" em todo o repositório.
    "MD035": {
      "style": "---"
    },

    // MD033: proíbe HTML inline nos 11 volumes, permitindo apenas os elementos
    // de acordeão e alinhamento usados no README.md.
    "MD033": {
      "allowed_elements": [
        "div",
        "details",
        "summary",
        "strong"
      ]
    }
  },
  "ignores": [
    "node_modules",
    ".git",
    "build/**"
  ]
}
